{
  "name": "neoriders-nackl-digger",
  "productName": "NeoRiders Nackl Digger",
  "version": "0.1.0",
  "description": "Manueller NACKL-Miner (Acki Nacki Bee Engine): Taps nur durch echte Klicks",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js",
    "dist": "electron-builder --win zip --x64"
  },
  "dependencies": {
    "@teamgosh/bee-sdk": "6.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.neorider.nackl-digger",
    "productName": "NeoRiders Nackl Digger",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    }
  },
  "license": "UNLICENSED"
}