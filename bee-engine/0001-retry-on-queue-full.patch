+// NeoRider patch: pause between retries of a submission that failed because the
+// node's external-message queue is full (TVM 621) or the request timed out /
+// could not reach the endpoint (client error 11, overloaded node).
+const SUBMIT_RETRY_DEFAULT_MS: u64 = 5000;
+
+thread_local! {
+    static SUBMIT_RETRY_MS: Cell<u64> = const { Cell::new(SUBMIT_RETRY_DEFAULT_MS) };
+}
+
+/// Interval between submission retries (1–10 s, set by the app).
+pub(crate) fn set_submit_retry_ms(ms: u64) {
+    SUBMIT_RETRY_MS.with(|c| c.set(ms.clamp(1000, 10000)));
+}
+
+fn submit_retry_ms() -> u64 {
+    SUBMIT_RETRY_MS.with(|c| c.get())
+}
+
+fn is_retryable(error: &str) -> bool {
+    let e = error.to_lowercase();
+    // An expired message is signed again on the next attempt (see `send_reusable`).
+    if e.contains("expired") {
+        return true;
+    }
+    // Executed and rejected by the contract: resending the same message cannot help.
+    if executed_and_failed(error) {
+        return false;
+    }
+    e.contains("621")
+        || e.contains("queue is full")
+        || e.contains("timeout")
+        || e.contains("timed out")
+        || e.contains("failed to fetch")
+        || e.contains("networkerror")
+        // Überlasteter Node antwortet mit leerem Body (Client-Fehler 12)
+        || e.contains("can not parse http request")
+        || e.contains("not a valid json")
+        || e.contains("eof while parsing")
+        // Mit nativen Netzwerkaufrufen kommen echte HTTP-Fehler statt "Failed to fetch"
+        || e.contains("invalid server response")
+        || e.contains("too many requests")
+        || e.contains(" 429")
+        || e.contains(" 502")
+        || e.contains(" 503")
+        || e.contains(" 504")
+}
+
+/// NeoRider patch: the node already knows this external message (DUPLICATE_MESSAGE).
+fn already_delivered(error: &str) -> bool {
+    error.to_lowercase().contains("duplicate_message")
+}
+
+/// NeoRider patch: the node executed the message and the contract rejected it
+/// (TVM 621 "compute phase" – not the same as 621 "queue is full").
+fn executed_and_failed(error: &str) -> bool {
+    let e = error.to_lowercase();
+    e.contains("compute phase") && !e.contains("queue is full")
+}
