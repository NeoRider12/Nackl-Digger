+    let deadline = deadline_ms.get();
+    let now = js_sys::Date::now() as u64;
+    let retry_ms = submit_retry_ms();
+    if !is_retryable(error) || deadline == 0 || now + retry_ms > deadline {
+        return false;
+    }
+    *attempt += 1;
+    send_callback(
+        callback,
+        CallbackData::data(
+            "submit_retry",
+            Some(json!({
+                "worker_id": worker_id,
+                "stage": stage,
+                "attempt": *attempt,
+                "retry_in_ms": retry_ms,
+                "message": error,
+            })),
+        ),
+    );
+    gloo_timers::future::TimeoutFuture::new(retry_ms as u32).await;
+    true
 }
 
