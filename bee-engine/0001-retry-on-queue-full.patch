+/// Messages are signed again this long after signing, shortly before they expire.
+/// Must stay below the message lifetime set in `Miner::new`.
+const MESSAGE_REUSE_MS: u64 = 105_000;
+
+/// NeoRider patch: sign `call_set` once and resend the identical message on retries.
+/// The node recognises a repeat as DUPLICATE_MESSAGE instead of queueing (or
+/// executing) a second copy. A new message is signed only when the old one is
+/// about to expire or the node reports it expired.
+async fn send_reusable(
+    worker: &MinerWorker,
+    prepared: &mut Option<(PreparedMessage, u64)>,
+    call_set: impl FnOnce() -> CallSet,
+    signer: Signer,
+    label: &str,
+) -> Result<(), String> {
+    let now = js_sys::Date::now() as u64;
+    let fresh = matches!(prepared, Some((_, signed_at)) if now < *signed_at + MESSAGE_REUSE_MS);
+    if !fresh {
+        let message = worker
+            .contract
+            .prepare_message(Some(call_set()), None, signer)
+            .await
+            .map_err(|e| format!("{label} ({e})"))?;
+        *prepared = Some((message, now));
+    }
+    let (message, _) = prepared.as_ref().unwrap();
+    match worker.contract.send_prepared_message(message).await {
+        Ok(_) => Ok(()),
+        Err(e) => {
+            let text = format!("{label} ({e})");
+            if text.to_lowercase().contains("expired") {
+                *prepared = None;
+            }
+            Err(text)
+        }
+    }
+}
