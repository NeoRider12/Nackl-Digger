+    /// NeoRider patch 0005 (GPU assist): like `compute`, but with a nonce found outside the
+    /// engine. Returns the leaf and whether the given nonce was used (false = CPU fallback).
+    pub fn compute_with_nonce(&mut self, params: ParamsOfCompute, nonce: u64) -> Option<(ComputedLeaf, bool)> {
+        if self.ends_at_ms.is_none() {
+            self.ends_at_ms = Some(params.now_ms.saturating_add(self.duration_ms));
+        }
+        if self.deadline_reached_ms(params.now_ms) {
+            return None;
+        }
+        if self.committed {
+            return None;
+        }
+        if let Some(prev) = self.last_now_ms {
+            if params.now_ms < prev {
+                return None;
+            }
+        }
+        self.last_now_ms = Some(params.now_ms);
+
+        let job_index = self.completed.len() as u128;
+        let (computed_leaf, used) = self.hash_processor.calc_hash_with_nonce(
+            ParamsOfCalcHash {
+                seed: &self.seed,
+                x: params.x,
+                y: params.y,
+                timestamp: params.now_ms,
+                complexity: self.target_bits,
+                idx: job_index,
+            },
+            nonce,
+        );
+        self.completed.push(computed_leaf.clone());
+        Some((computed_leaf, used))
+    }
+
+    /// NeoRider patch 0005: index of the next tap leaf (= taps computed so far).
+    pub fn next_index(&self) -> u64 {
+        self.completed.len() as u64
+    }
+
     pub fn get_merkle(&mut self) -> ResultOfGetMerkleSnapshot {
         if !self.committed {
             self.hash_processor.commit();
diff --git a/bee_miner/src/core/processor.rs b/bee_miner/src/core/processor.rs
index 14c02a6..1aa5913 100644
--- a/bee_miner/src/core/processor.rs
+++ b/bee_miner/src/core/processor.rs
@@ -55,6 +55,28 @@ impl MiningProcessor {
         }
     }
 
+    /// NeoRider patch 0005 (GPU assist): use a nonce found outside the engine (WebGPU). The
+    /// leaf is computed and checked here exactly like in `calc_hash_blake`; if the nonce does
+    /// not meet the target (wrong seed/index/timestamp, GPU error) the normal CPU search runs.
+    pub fn calc_hash_with_nonce(&mut self, params: ParamsOfCalcHash, nonce: u64) -> (ComputedLeaf, bool) {
+        let threshold = u128::MAX >> params.complexity;
+        let leaf = Leaf {
+            index: params.idx,
+            nonce,
+            seed: params.seed.to_string(),
+            x: params.x,
+            y: params.y,
+            timestamp: params.timestamp,
+            complexity: params.complexity,
+        };
+        let computed_leaf = leaf.compute();
+        if computed_leaf.hash_num() < threshold {
+            self.merkle.add_leaf(&computed_leaf);
+            return (computed_leaf, true);
+        }
+        (self.calc_hash_blake(params), false)
+    }
+
     pub fn get_merkle_root(&self) -> Vec<u8> {
         self.merkle.get_merkle_root()
     }
