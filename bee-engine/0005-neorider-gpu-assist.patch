+    /// NeoRider patch 0005 (GPU assist): parameters of the next tap leaf of the running worker
+    /// as JSON `{"seed","index","complexity"}`, or an empty string when no worker is computing.
+    #[wasm_bindgen(js_name = tap_params)]
+    pub fn tap_params(&self) -> String {
+        match self.workers.borrow().iter().find(|w| w.status == MinerStatus::Computing) {
+            Some(w) if !w.seed.is_empty() => serde_json::json!({
+                "seed": w.seed,
+                "index": w.tap_next.get(),
+                "complexity": w.hard_complexity,
+            })
+            .to_string(),
+            _ => String::new(),
+        }
+    }
+
+    /// NeoRider patch 0005 (GPU assist): tap with the timestamp used for the GPU search and the
+    /// nonce it found (as two u32 halves). The engine checks the leaf and falls back to its own
+    /// CPU search if the nonce does not meet the target.
+    #[wasm_bindgen(js_name = add_tap_nonce)]
+    pub fn add_tap_nonce(&self, x: u32, y: u32, now_ms: f64, nonce_lo: u32, nonce_hi: u32) -> Result<(), JsError> {
+        let nonce = ((nonce_hi as u64) << 32) | nonce_lo as u64;
+        match self.workers.borrow().iter().find(|w| w.status == MinerStatus::Computing) {
+            Some(worker) => {
+                let _ = worker.sender.unbounded_send(MinerCommand::QueueTapNonce { x, y, now_ms: now_ms as u64, nonce });
+            }
+            None => return Err(JsError::new("No running workers to add tap to")),
+        }
+        Ok(())
+    }
+
